# Copy to /opt/system2/trialllm/.env on the VPS (chmod 600). Never commit the real file.
TRIANGLE_REGION_ID=uk-1
# Same value as the Pages secret TRIANGLE_INFERENCE_TOKEN. Make one with: openssl rand -hex 32
TRIANGLE_INFERENCE_TOKEN=
TRIANGLE_PUBLIC_MODEL_ID=triangle-from-scratch-research-v1
TRIANGLE_MODEL_DIR=/opt/system2/trialllm/models
# From Cloudflare Zero Trust > Networks > Tunnels > Create tunnel (free). Public hostname -> http://inference:8000
CLOUDFLARE_TUNNEL_TOKEN=
