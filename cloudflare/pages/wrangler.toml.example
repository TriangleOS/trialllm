# Place only in the existing Cloudflare Pages project's Functions source. Preserve that project's current static build output.
# Cloudflare Pages/Workers handles routing/auth middleware; this does not host model inference.
compatibility_date = "2026-11-08"
compatibility_flags = ["nodejs_compat"]

# Configure variables and secrets in the Pages project dashboard or `wrangler pages secret put`.
