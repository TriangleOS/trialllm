# Merge into the Pages project that already serves llm.triangleos.com; keep its build output.
# This gateway does auth and routing only. It does not run the model.
compatibility_date = "2026-11-08"
compatibility_flags = ["nodejs_compat"]

# Set variables and secrets in the Pages dashboard (see .dev.vars.example).
# Never put TRIANGLE_INFERENCE_TOKEN or SUPABASE_JWT_SECRET in this file.
