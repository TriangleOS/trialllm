NODE_ENV=development
PORT=8787
# Exact browser origin(s), comma separated. No wildcard in production.
ALLOWED_ORIGINS=http://localhost:5173,https://trianglellm.lovable.app

# OIDC issuer and audience for Triangle user access tokens.
OIDC_ISSUER=https://identity.example.africa/
OIDC_AUDIENCE=trianglellm-api
OIDC_JWKS_URL=https://identity.example.africa/.well-known/jwks.json

# One deployment per region. The OIDC provider must issue triangle_region_id
# from trusted user/tenant assignment, never from browser-submitted input.
TRIANGLE_REGION_ID=example-region

# OpenAI-compatible API root reachable only from this regional API service.
# Example format only; configure an actual region-local service.
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_API_KEY=
TRIANGLE_MODEL_ID=configure-an-approved-model-id

# Set only if running behind a trusted reverse proxy; see Express trust proxy docs.
TRUST_PROXY_HOPS=0
